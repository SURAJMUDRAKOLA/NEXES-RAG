# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=

# AI providers. Use a real key from your provider dashboard; do not use public shared keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Model config (Section 5.3)
LLM_PROVIDER=openai/gpt-4o
LLM_FAST_PROVIDER=openai/gpt-4o-mini
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
RERANK_PROVIDER=cohere

# Offline alternatives (uncomment to switch, Section 10.2):
# LLM_PROVIDER=ollama/mistral-nemo
# LLM_FAST_PROVIDER=ollama/llama3.2:3b
# EMBED_MODEL=ollama/nomic-embed-text
# EMBED_DIM=768
# RERANK_PROVIDER=flashrank

# Redis
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false
REST_RAG_TOP_K=8
REST_RAG_MAX_CANDIDATES=200

# Ollama (offline mode)
OLLAMA_BASE_URL=http://localhost:11434

# Langfuse (optional — Section 2.2)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App
APP_ENV=development
FRONTEND_URL=http://localhost:3000
